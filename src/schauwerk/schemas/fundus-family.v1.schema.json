{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heimgewebe.github.io/schauwerk/schemas/fundus-family.v1.schema.json",
  "title": "Schauwerk Fundus Family v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "tags"],
  "properties": {
    "schema_version": {"const": "schauwerk-fundus-family.v1"},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    }
  }
}
