{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heimgewebe.github.io/schauwerk/schemas/fundus-review-bundle.v1.schema.json",
  "title": "Schauwerk Fundus review bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "family_id",
    "family_title",
    "title",
    "description",
    "plan_digest",
    "variant_count",
    "variants",
    "fixtures",
    "consumer_template_mode",
    "consumer_template_sha256",
    "consumer_css_sha256",
    "entrypoint",
    "files",
    "network_dependencies",
    "portable",
    "fundus_authoritative",
    "visual_acceptance_inferred",
    "package_created",
    "review_digest"
  ],
  "properties": {
    "schema_version": {"const": "schauwerk-fundus-review-bundle.v1"},
    "family_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "family_title": {"type": "string", "minLength": 1, "maxLength": 240},
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\u0000-\u001F\u007F]+$"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "pattern": "^[^\u0000-\u001F\u007F]*$"
    },
    "plan_digest": {"$ref": "#/$defs/sha256"},
    "variant_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/variant"}
    },
    "fixtures": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/fixture"}
    },
    "consumer_template_mode": {"enum": ["default", "custom"]},
    "consumer_template_sha256": {"$ref": "#/$defs/sha256"},
    "consumer_css_sha256": {"$ref": "#/$defs/sha256"},
    "entrypoint": {"const": "index.html"},
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/file"}
    },
    "network_dependencies": {"const": false},
    "portable": {"const": true},
    "fundus_authoritative": {"const": true},
    "visual_acceptance_inferred": {"const": false},
    "package_created": {"const": false},
    "review_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "relative_file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "pattern": "^(index\\.html|review\\.(css|js)|assets/[a-z0-9._-]+\\.(svg|png|jpg|webp)|fixtures/fixture-[a-z0-9._-]+\\.(png|jpg|webp))$"
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "build_digest",
        "output_role",
        "output_sha256",
        "output_media_type",
        "output_filename",
        "acceptance_state",
        "file"
      ],
      "properties": {
        "asset_id": {"$ref": "#/$defs/asset_id"},
        "build_digest": {"$ref": "#/$defs/sha256"},
        "output_role": {"enum": ["vector", "mask", "outline", "raster", "texture", "preview"]},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "output_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "output_media_type": {"enum": ["image/svg+xml", "image/png", "image/jpeg", "image/webp"]},
        "output_filename": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "acceptance_state": {"enum": ["unreviewed", "accepted", "rejected", "mixed", "invalid"]},
        "file": {"type": "string", "pattern": "^assets/[a-z0-9._-]+\\.(svg|png|jpg|webp)$"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "media_type", "sha256", "bytes"],
      "properties": {
        "id": {"$ref": "#/$defs/asset_id"},
        "file": {"type": "string", "pattern": "^fixtures/fixture-[a-z0-9._-]+\\.(png|jpg|webp)$"},
        "media_type": {"enum": ["image/png", "image/jpeg", "image/webp"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 16777216}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_file"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 33554432}
      }
    }
  }
}
