{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heimgewebe.local/schauwerk/search-index.v1.schema.json",
  "title": "Schauwerk Search Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "state", "core_blocked", "source_set_digest", "documents", "errors", "index_digest"],
  "properties": {
    "schema_version": {"const": "schauwerk-search-index.v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["ready", "disabled", "degraded"]},
    "core_blocked": {"const": false},
    "source_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_id", "source_id", "fact_key"],
        "properties": {
          "document_id": {"type": "string", "pattern": "^doc\\.[a-z0-9._-]+$"},
          "adapter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "fact_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
        }
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "index_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
