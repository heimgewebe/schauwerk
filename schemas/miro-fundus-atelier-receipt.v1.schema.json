{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schauwerk.local/schemas/miro-fundus-atelier-receipt.v1.schema.json",
  "title": "Schauwerk Miro Fundus Atelier receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "success",
    "board_alias",
    "board_reference_digest",
    "family_id",
    "plan_digest",
    "projection_mode",
    "variants",
    "variant_count",
    "readback",
    "fundus_authoritative",
    "miro_source_of_truth",
    "visual_acceptance_inferred",
    "package_created",
    "sanitized_references",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": "schauwerk-miro-fundus-atelier-receipt.v1"},
    "success": {"const": true},
    "board_alias": {"type": "string", "minLength": 1, "maxLength": 64},
    "board_reference_digest": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "family_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "plan_digest": {"$ref": "#/$defs/sha256"},
    "projection_mode": {"const": "append_create_only"},
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/variant"}
    },
    "variant_count": {"type": "integer", "minimum": 1},
    "readback": {"$ref": "#/$defs/readback"},
    "fundus_authoritative": {"const": true},
    "miro_source_of_truth": {"const": false},
    "visual_acceptance_inferred": {"const": false},
    "package_created": {"const": false},
    "sanitized_references": {"const": true},
    "receipt_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "item_id": {"type": "string", "pattern": "^[0-9]{1,32}$"},
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "build_digest",
        "output_sha256",
        "output_role",
        "fundus_acceptance_state",
        "frame_item_id",
        "image_item_id",
        "render_width",
        "parent_verified",
        "geometry_verified",
        "position_verified"
      ],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "build_digest": {"$ref": "#/$defs/sha256"},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "output_role": {"type": "string", "minLength": 1, "maxLength": 64},
        "fundus_acceptance_state": {
          "enum": ["unreviewed", "accepted", "rejected", "mixed", "invalid"]
        },
        "frame_item_id": {"$ref": "#/$defs/item_id"},
        "image_item_id": {"$ref": "#/$defs/item_id"},
        "render_width": {"type": "number", "exclusiveMinimum": 0, "maximum": 800},
        "parent_verified": {"const": true},
        "geometry_verified": {"const": true},
        "position_verified": {"const": true}
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_image_count",
        "after_image_count",
        "inventory_pages",
        "all_created_images_present",
        "all_created_images_parent_verified"
      ],
      "properties": {
        "before_image_count": {"type": "integer", "minimum": 0},
        "after_image_count": {"type": "integer", "minimum": 1},
        "inventory_pages": {"type": "integer", "minimum": 2},
        "all_created_images_present": {"const": true},
        "all_created_images_parent_verified": {"const": true}
      }
    }
  }
}
